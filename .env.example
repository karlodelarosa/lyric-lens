# Required for browser + server Supabase client (get from Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Some docs use this name; Next still needs NEXT_PUBLIC_* for the browser bundle:
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Optional server-side alias (recommended for backend-only modules):
SUPABASE_URL=https://your-project-ref.supabase.co
# Preferred key format:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional server-side alias:
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Backward-compatible fallback key:
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only key. Never expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
